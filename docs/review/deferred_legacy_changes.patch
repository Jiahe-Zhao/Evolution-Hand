+def support_rays(urdf, nodes, poses):
+    root = ET.parse(urdf).getroot()
+    links = {link.get('name'): link for link in root.findall('link')}
+    children = {}
+    for joint in nodes:
+        children.setdefault(joint.find('parent').get('link'), []).append(joint.find('child').get('link'))
+    supports = []
+    for digit in range(2, 6):
+        name = f'link_{digit}_0'
+        if name not in poses:
+            continue
+        descendants = [child for child in children.get(name, [])
+                       if re.fullmatch(fr'link_{digit}_[1-9][0-9]*', child)]
+        start = poses[name][:3, 3]
+        if descendants:
+            end = poses[min(descendants, key=lambda child: int(child.rsplit('_', 1)[1]))][:3, 3]
+        else:
+            collision = links[name].find('collision')
+            mesh_node = collision.find('geometry/mesh') if collision is not None else None
+            if mesh_node is None:
+                raise ValueError(f'No distal joint or collision mesh for {name}')
+            mesh = trimesh.load(Path(urdf).parent / mesh_node.get('filename'), force='mesh')
+            scale = np.fromstring(mesh_node.get('scale', '1 1 1'), sep=' ')
+            vertices = np.asarray(mesh.vertices) * scale
+            local_end = np.array([0., 0., vertices[:, 2].max()])
+            end = poses[name][:3, :3] @ local_end + start
+        if np.linalg.norm(end - start) < 0.005:
+            raise ValueError(f'Degenerate proximal support ray for {name}')
+        supports.append((name, start, end))
+    if len(supports) < 2:
+        raise ValueError('A continuous palm needs at least two surviving long-finger roots')
+    return supports
+
